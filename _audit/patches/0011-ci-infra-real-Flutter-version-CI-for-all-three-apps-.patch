From 9a7de26701b810d493d06f09f02ba881460305e2 Mon Sep 17 00:00:00 2001
From: "Claude (audit)" <noreply@anthropic.com>
Date: Sun, 11 Oct 2026 00:20:11 +0600
Subject: [PATCH 11/14] ci/infra: real Flutter version, CI for all three apps,
 reproducible web build

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_011d4mgSxngjRmAXosGe4ry4

- build-apk.yml pinned Flutter 3.27.4 (Dart 3.6) while pubspec needs Dart
  >= 3.13.5, so 'pub get' could not succeed; use current stable. Analyze no
  longer '|| true', tests run, and the APK is built with API_BASE_URL.
- New ci.yml: backend (ruff, check, migrations check, tests), frontend
  (lint, tests, build) and mobile (analyze, test) on every push.
- render.yaml: 'npm ci' with the committed lockfile instead of deleting it;
  CORS comment matches the new settings.
- README/guide: frontend and test commands, correct Flutter version.
---
 .github/workflows/build-apk.yml | 11 ++++--
 .github/workflows/ci.yml        | 63 +++++++++++++++++++++++++++++++++
 README.md                       | 29 ++++++++++++---
 RENDER_DEPLOYMENT_GUIDE.md      |  4 +--
 render.yaml                     |  8 +++--
 5 files changed, 103 insertions(+), 12 deletions(-)
 create mode 100644 .github/workflows/ci.yml

diff --git a/.github/workflows/build-apk.yml b/.github/workflows/build-apk.yml
index 11d14e5..853e6e2 100644
--- a/.github/workflows/build-apk.yml
+++ b/.github/workflows/build-apk.yml
@@ -24,8 +24,8 @@ jobs:
       - name: Set up Flutter
         uses: subosito/flutter-action@v2
         with:
+          # pubspec.yaml needs Dart >= 3.13.5 (Flutter >= 3.44); the old 3.27.4 pin could not resolve packages.
           channel: stable
-          flutter-version: 3.27.4
 
       - name: Cache Flutter packages
         uses: actions/cache@v4
@@ -42,11 +42,16 @@ jobs:
 
       - name: Analyze
         working-directory: mobile
-        run: flutter analyze --no-fatal-infos || true
+        run: flutter analyze --no-fatal-infos
+
+      - name: Test
+        working-directory: mobile
+        run: flutter test
 
       - name: Build release APK
         working-directory: mobile
-        run: flutter build apk --release
+        # The app's default server; set the repository variable API_BASE_URL to change it.
+        run: flutter build apk --release --dart-define=API_BASE_URL=${{ vars.API_BASE_URL || 'https://tuitiontrack-api.onrender.com' }}
 
       - name: Sign APK (placeholder — replace with your keystore)
         # NOTE: This step signs with the debug key so the workflow runs without
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..7dd891c
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,63 @@
+name: CI
+
+on:
+  push:
+    branches: ['**']
+  pull_request:
+
+jobs:
+  backend:
+    name: Backend (Django)
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: backend
+    env:
+      DEBUG: 'True'
+      SECRET_KEY: ci-only-not-secret
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version-file: backend/.python-version
+          cache: pip
+          cache-dependency-path: backend/requirements.txt
+      - run: pip install -r requirements.txt ruff
+      - run: ruff check .
+      - run: python manage.py check
+      - run: python manage.py makemigrations --check --dry-run
+      - run: python manage.py test --parallel 4
+
+  frontend:
+    name: Frontend (React)
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: frontend
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version-file: frontend/.nvmrc
+          cache: npm
+          cache-dependency-path: frontend/package-lock.json
+      - run: npm ci
+      - run: npm run lint
+      - run: npm test
+      - run: npm run build
+
+  mobile:
+    name: Mobile (Flutter)
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: mobile
+    steps:
+      - uses: actions/checkout@v4
+      - uses: subosito/flutter-action@v2
+        with:
+          channel: stable
+          cache: true
+      - run: flutter pub get
+      - run: flutter analyze --no-fatal-infos
+      - run: flutter test
