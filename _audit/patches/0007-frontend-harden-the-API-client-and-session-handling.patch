+  if (_offsetPromise && Date.now() - _offsetAt < OFFSET_TTL_MS) return _offsetPromise;
+  _offsetAt = Date.now();
+  _offsetPromise = (async () => {
+    try {
+      const before = Date.now();
+      const resp = await fetch(`${BASE_URL}/meta/`, { headers: { Accept: 'application/json' } });
