diff --git a/backend/apps/students/serializers.py b/backend/apps/students/serializers.py
index a1cd4ae..933cb3e 100644
--- a/backend/apps/students/serializers.py
+++ b/backend/apps/students/serializers.py
@@ -28,6 +28,19 @@ class StudentProfileSerializer(serializers.ModelSerializer):
         ]
         read_only_fields = ['id', 'created_at', 'updated_at']
 
+    # Written by the tutor who owns the account; a second tutor the student is
+    # connected to must not read them.
+    OWNER_ONLY_FIELDS = ('notes', 'tuition_fee', 'cycle_length')
+
+    def to_representation(self, instance):
+        data = super().to_representation(instance)
+        request = self.context.get('request')
+        viewer_id = getattr(getattr(request, 'user', None), 'id', None)
+        if viewer_id is None or instance.user.tutor_id != viewer_id:
+            for field in self.OWNER_ONLY_FIELDS:
+                data.pop(field, None)
+        return data
+
 
 class StudentListSerializer(serializers.ModelSerializer):
     """
diff --git a/backend/apps/students/services.py b/backend/apps/students/services.py
index e221297..ddc955f 100644
--- a/backend/apps/students/services.py
+++ b/backend/apps/students/services.py
@@ -69,3 +69,19 @@ def unenroll_student(tuition, student):
         enrollment.left_at = timezone.now()
         enrollment.save(update_fields=['is_active', 'left_at'])
     return enrollment
+
+
+def student_homework(student):
+    """
+    Homework a student sees: their own rows, plus shared group tasks of groups
+    they are in now — except group tasks they already have a personal copy of
+    (that copy replaces the shared row for them).
+    """
+    from .models import Homework
+    tuition_ids = TuitionEnrollment.objects.filter(student=student, is_active=True).values_list('tuition_id', flat=True)
+    copied_group_ids = Homework.objects.filter(
+        student=student, group_source__isnull=False
+    ).values_list('group_source_id', flat=True)
+    return Homework.objects.filter(
+        Q(student=student) | Q(student__isnull=True, tuition_id__in=tuition_ids)
+    ).exclude(id__in=copied_group_ids)
