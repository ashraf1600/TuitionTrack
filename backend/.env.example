# Copy to ".env" for your own PC. Online, set these in the hosting platform instead
# (see render.yaml); never commit real values.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Comma-separated. Leave unset while DEBUG=True to accept any host (phones on your Wi-Fi).
# ALLOWED_HOSTS=api.example.com

# ── Database ────────────────────────────────────────────────────────────────
# Unset: the SQLite file db.sqlite3. Set: PostgreSQL.
# Supabase: Connect → "Session pooler" (works over IPv4), e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── Uploaded files ──────────────────────────────────────────────────────────
# Unset: the media/ folder. Set: an S3-compatible bucket (must be public for reading).
# S3_BUCKET=tuitiontrack-media
# S3_REGION=ap-southeast-1
# S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_PUBLIC_DOMAIN=<project-ref>.supabase.co/storage/v1/object/public/tuitiontrack-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_SIZE_MB=10

# ── Website address (password-reset links, CORS) ────────────────────────────
# FRONTEND_URL=https://tuitiontrack.example.com
# CORS_ALLOWED_ORIGINS=https://tuitiontrack.example.com

# ── Email ───────────────────────────────────────────────────────────────────
# Console: e-mails (password-reset codes) are only printed in this terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Online on Render's free plan SMTP is blocked — send over HTTPS with Brevo instead
# (free, 300/day, a verified Gmail sender is enough; see RENDER_DEPLOYMENT_GUIDE.md):
# EMAIL_BACKEND=config.email_backends.BrevoEmailBackend
# BREVO_API_KEY=xkeysib-...
# DEFAULT_FROM_EMAIL=TuitionTrack <your_verified_sender@gmail.com>
# Or Resend (needs your own verified domain):
# EMAIL_BACKEND=config.email_backends.ResendEmailBackend
# RESEND_API_KEY=re_...
# Or plain SMTP (works on your PC and paid hosting, not Render free):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=TuitionTrack <noreply@tuitiontrack.app>

# ── Sign in with Google ─────────────────────────────────────────────────────
# OAuth client of type "Web application" (Google Cloud Console → Credentials).
# Leave empty to hide the Google button on the website and in the app.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_SIGNUP_ENABLED=True

# ── Sign-in ─────────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
# AUTH_THROTTLE_RATE=20/min
DISPLAY_TIME_ZONE=Asia/Dhaka
